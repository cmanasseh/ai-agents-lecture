{
  "model": "claude-opus-5-5",
  "permissions": {
    "allow": [
      "Bash(uv run ruff:*)",
      "Bash(uv sync)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Edit(./slides/**)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./runs/**)",
      "Bash(pip:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tests.sh" }
        ]
      }
    ]
  }
}
